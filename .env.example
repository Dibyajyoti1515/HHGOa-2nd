# ============================================================
# .env.example — copy to .env and fill in secrets before running.
# See config/settings.py for how each key is loaded and its default.
# ============================================================

# ---------- Ingestion (mirrors Cell 1 of Update_version_2.ipynb) ----------
SAMPLE_SIZE_PER_LANG=10000
INGESTION_BATCH_SIZE=200
EMBED_BATCH_SIZE=32
DEDUP_THRESHOLD=0.9
UNIFIED_FILE=unified_corpus.parquet
SQLITE_DB=native_text_lookup.db

# ---------- Qdrant / embedding models ----------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=msmarco_english_corpus
EMBED_MODEL=BAAI/bge-small-en-v1.5
EMBED_DIM=384
SPARSE_MODEL=Qdrant/bm25

# ---------- Retrieval ----------
RETRIEVAL_MODE=hybrid_weighted
CONFIDENCE_THRESHOLD=0.85
HYBRID_DENSE_WEIGHT=0.75
HYBRID_SPARSE_WEIGHT=0.25
HYBRID_CANDIDATE_POOL=20
TOP_K=5

# ---------- LLM fallback (Groq) ----------
GROQ_API_KEY=
# Verify current model name in the Groq console — may have changed since this was set.
GROQ_MODEL=llama-3.3-70b-versatile

# ---------- Legacy TTS (ElevenLabs) — RETIRED, unused in the live path ----------
# Kept only so tts/elevenlabs_client.py still imports; api/ws_voice.py uses
# Sarvam TTS instead (see CLAUDE.md §0.1). Not read anywhere on the live path.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
TTS_WORD_LIMIT=200
TTS_OUTPUT_DIR=./tts_out

# ---------- Sarvam AI STT (realtime, websocket) ----------
SARVAM_API_KEY=
SARVAM_TRANSLATE_URL=https://api.sarvam.ai/translate

SARVAM_STT_WS_URL=wss://api.sarvam.ai/speech-to-text/ws   # placeholder — confirm exact path/version in Sarvam docs
SARVAM_STT_LANGUAGE_CODE=unknown                          # "unknown" = auto-detect
SARVAM_STT_SAMPLE_RATE=16000
SARVAM_STT_MODEL=saarika:v2                                # placeholder — confirm current model name

# ---------- Sarvam AI TTS (realtime, websocket) ----------
SARVAM_TTS_WS_URL=wss://api.sarvam.ai/text-to-speech/ws    # placeholder — confirm exact path/version in Sarvam docs
SARVAM_TTS_SPEAKER=meera                                    # placeholder — confirm current speaker/voice name
SARVAM_TTS_SAMPLE_RATE=16000
SARVAM_TTS_LANGUAGE_CODE=en-IN

# ---------- Voice endpoint (api/ws_voice.py) ----------
VOICE_WS_MAX_TURN_SECONDS=30       # safety cutoff for a single recording

# ---------- Guardrails ----------
# File-based wordlists (one term per line, '#' = comment, empty file = that
# check is a no-op) — see CLAUDE.md Decision #7. NOT a comma-separated list.
GUARDRAIL_MAX_QUERY_LENGTH=500
GUARDRAIL_MIN_QUERY_LENGTH=1
GUARDRAIL_PROFANITY_FILE=guardrails/wordlists/profanity.txt
GUARDRAIL_BLOCKED_TOPICS_FILE=guardrails/wordlists/blocked_topics.txt
# "detailed" -> 404/error body names which check failed (e.g. "blocked_topic").
# "generic"  -> 404/error body is a flat, uninformative error message.
GUARDRAIL_RESPONSE_DETAIL=detailed

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_DIR=./logs